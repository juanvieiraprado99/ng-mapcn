{
  "name": "ng-mapcn",
  "short_name": "ng-mapcn",
  "description": "Beautiful, ready-to-use map components for Angular. Built on MapLibre GL and styled with Tailwind CSS.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "lang": "en",
  "icons": [
    { "src": "/icon-192x192.svg", "sizes": "192x192", "type": "image/svg+xml" },
    { "src": "/icon-256x256.svg", "sizes": "256x256", "type": "image/svg+xml" },
    { "src": "/icon-384x384.svg", "sizes": "384x384", "type": "image/svg+xml" },
    { "src": "/icon-512x512.svg", "sizes": "512x512", "type": "image/svg+xml" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ]
}
