{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../../dist/ng-mapcn/schematics",
    "rootDir": "./schematics"
  },
  "include": ["schematics/**/*.ts"],
  "exclude": ["schematics/add/files/**", "schematics/**/*.spec.ts"]
}
